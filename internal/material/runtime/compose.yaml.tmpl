services:
  {{.OAuthService}}:
    build:
      context: .
      dockerfile: translator.Containerfile
    restart: unless-stopped
    init: true
    volumes:
      - ../state/codex:/home/node/.codex
    networks:
      - backplane
      - egress
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp:size=16m,mode=1777
      - /home/node/.local:uid=1000,gid=1000,mode=0700
    pids_limit: 128
    mem_limit: 384m
    cpus: 0.75
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - 'const net=require("node:net");const socket=net.connect({host:"127.0.0.1",port:{{.OAuthPort}}},()=>{socket.end();process.exit(0)});socket.setTimeout(2000,()=>process.exit(1));socket.on("error",()=>process.exit(1))'
      interval: 20s
      timeout: 4s
      retries: 4
      start_period: 20s
    labels:
      {{.OwnerLabel}}: "true"

  {{.APIService}}:
    build:
      context: .
      dockerfile: api.Containerfile
    restart: unless-stopped
    depends_on:
      {{.OAuthService}}:
        condition: service_healthy
    volumes:
      - ../state/api-key:/run/secrets/unapid_api_key:ro
    expose:
      - "{{.GatewayPort}}"
    networks:
      n8n:
        aliases:
          - {{.GatewayHost}}
      backplane: {}
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    read_only: true
    pids_limit: 64
    mem_limit: 128m
    cpus: 0.25
    healthcheck:
      test:
        - CMD
        - /unapid
        - internal-probe
        - --url
        - http://127.0.0.1:{{.GatewayPort}}/health
      interval: 20s
      timeout: 4s
      retries: 4
      start_period: 10s
    labels:
      {{.OwnerLabel}}: "true"

networks:
  backplane:
    internal: true
  egress: {}
  n8n:
    external: true
    name: {{.Network}}
